{
  "name": "panorama-stitcher",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop panorama image stitching application foundation",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "test": "node --experimental-default-type=module --test test",
    "start": "npm run build && cross-env NODE_ENV=production electron ."
  },
  "dependencies": {
    "@adobe/react-spectrum": "^3.42.0",
    "@techstark/opencv-js": "^4.9.0-release.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
